# ─── Backend ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/forgeai

# JWT
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Google Custom Search Engine — powers the cold outreach prospect finder
# Free tier: 100 queries/day. Setup: console.cloud.google.com → Custom Search API
# Then create a CSE at: programmablesearchengine.google.com (set to "Search the entire web")
GOOGLE_CSE_KEY=your_google_custom_search_api_key
GOOGLE_CSE_ID=your_cse_cx_id

# Google OAuth — Gmail integration (cold outreach "Send via Gmail")
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Scopes needed: gmail.send, userinfo.email, userinfo.profile
# Authorised redirect URI: http://localhost:4000/api/gmail/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/gmail/callback
BACKEND_URL=http://localhost:4000

# AI Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# Python Service
PYTHON_SERVICE_URL=http://localhost:5001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# ─── Email (Nodemailer — for contact form lead notifications + team invites) ──
# Works with any SMTP provider. Example: Gmail (use an App Password), Resend, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="ForgeAI <noreply@yourdomain.com>"

# ─── Frontend ──────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api
VITE_WS_URL=http://localhost:4000
